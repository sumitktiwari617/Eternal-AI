# ========================================================
# ETERNAL AI TRADING AGENT - CONFIGURATION TEMPLATE (.env)
# ========================================================

# Asset Settings
SYMBOL=ETERNAL.NS
EXCHANGE=NSE
TIMEFRAME=5m
KOTAK_TOKEN=5097
KOTAK_SEGMENT=nse_cm
KOTAK_PRODUCT=MIS

# Strategy & Indicators
EMA_FAST=20
EMA_SLOW=50
RSI_PERIOD=14
RSI_BUY_MIN=50.0
RSI_BUY_MAX=70.0
RSI_SELL_MIN=30.0
RSI_SELL_MAX=50.0
ATR_PERIOD=14
STOP_LOSS_ATR_MULT=1.5
TARGET_ATR_MULT=2.0

# Capital & Risk Management
INITIAL_CAPITAL=100000.0
DEFAULT_QUANTITY=1
MAX_RISK_PER_TRADE_RUPEES=2000.0
COST_RATE_PER_SIDE=0.0005

# Safety & Execution Controls
# Set REAL_ORDERS_ENABLED=True only when ready for real-money execution!
REAL_ORDERS_ENABLED=False
EMERGENCY_STOP=False
AGENT_MODE=PAPER
MAX_DATA_AGE_SECONDS=300
ENFORCE_MARKET_HOURS=False
MARKET_OPEN_TIME=09:15
MARKET_CLOSE_TIME=15:30
TIMEZONE=Asia/Kolkata

# Server & Dashboard Ports
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
POLL_INTERVAL_SECONDS=30
PAPER_LOG_FILE=eternal_paper_log.jsonl
BACKTEST_CSV_FILE=eternal_backtest_results.csv

# Cloud Deployment & Desktop Mobility
# Paste your deployed Render backend URL below so start_ai_tunnel.bat automatically registers
# its public tunnel URL with your cloud backend when launched on ANY desktop PC!
RENDER_BACKEND_URL=https://your-app-backend.onrender.com

# Localhost AI Model Microservice (Port 8001)
AI_SERVICE_HOST=127.0.0.1
AI_SERVICE_PORT=8001
AI_MODEL_SERVICE_URL=http://127.0.0.1:8001
AI_SECRET_TOKEN=
AI_TUNNEL_SKIP_WARNING=True

# Optional Tunnel Authtoken (Free ngrok authtoken from https://dashboard.ngrok.com)
NGROK_AUTHTOKEN=

# Kotak Neo Broker Credentials (Optional - leave empty for Paper/Simulation mode)
# Paste credentials below when ready for live real-money execution
KOTAK_CONSUMER_KEY=your_consumer_key_here
KOTAK_CONSUMER_SECRET=your_consumer_secret_here
KOTAK_MOBILE_NUMBER=+91XXXXXXXXXX
KOTAK_CLIENT_CODE=your_ucc_code
KOTAK_MPIN=your_6_digit_mpin
KOTAK_ENVIRONMENT=prod
